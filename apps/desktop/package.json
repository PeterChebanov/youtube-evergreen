{
  "name": "@youtube-ai-tool/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Evergreen Studio: Electron window with the Angular UI",
  "main": "electron/main.cjs",
  "scripts": {
    "ui:dev": "ng serve --port 4200",
    "build": "ng build",
    "dev": "ng build --configuration development && electron .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.spec.json",
    "check:layout": "ng build && node scripts/check-layout.mjs",
    "check:layout:only": "node scripts/check-layout.mjs",
    "smoke:electron": "ng build && node scripts/smoke-electron.mjs",
    "setup:binaries": "node node_modules/electron/install.js && playwright install chromium"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@youtube-ai-tool/shared": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "electron": "44.5.1",
    "playwright": "1.63.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
