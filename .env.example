NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://youtube_ai:youtube_ai@localhost:5432/youtube_ai?schema=public
REDIS_URL=redis://localhost:6379

# LLM: mock | openai
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Per-prompt models (used when LLM_PROVIDER=openai)
LLM_MODEL_VIDEO_BASIC=gpt-4o-mini
LLM_MODEL_AUTHOR_STYLE=gpt-4o-mini
LLM_MODEL_ADVICE=gpt-4o
LLM_MODEL_PLANNING=gpt-4o
LLM_MODEL_RESEARCH=gpt-4o-mini
LLM_MODEL_WRITER=gpt-4o
LLM_MODEL_DEFAULT=gpt-4o-mini

# Rough USD per 1M tokens (for cost estimates)
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.6
LLM_EST_OUTPUT_TOKENS_PER_VIDEO=120

YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=10000
SHORTS_MIN_DURATION_SEC=60

YTDLP_MAX_CONCURRENT=1
YTDLP_DELAY_MS=3000
