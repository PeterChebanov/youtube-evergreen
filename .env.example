NODE_ENV=development
PORT=3000

# docker compose publishes Postgres on POSTGRES_PORT (default 5432)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://youtube_ai:youtube_ai@localhost:5432/youtube_ai?schema=public
REDIS_URL=redis://localhost:6379
# Integration tests only (separate database, created automatically)
TEST_DATABASE_URL=postgresql://youtube_ai:youtube_ai@localhost:5432/youtube_ai_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/15

# Omit keys → mock LLM (tests). Set LLM_PROVIDER=mock to force mock even with keys.
# With any vendor key below, real providers are used; pick models per step in the desktop UI.
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=8192

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro

# Embeddings always use OpenAI when OPENAI_API_KEY is set
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Cost estimate shown before channel research
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.6
LLM_EST_INPUT_TOKENS_PER_VIDEO=350
LLM_EST_OUTPUT_TOKENS_PER_VIDEO=120

# Empty key -> built-in mock gateway
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_QUOTA_RESERVE_UNITS=200
SHORTS_MIN_DURATION_SEC=60

# ytdlp | mock
SUBTITLES_PROVIDER=ytdlp
YTDLP_PATH=yt-dlp
YTDLP_DELAY_MS=3000
YTDLP_MAX_RETRIES=3
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
YTDLP_SUB_LANGS=ru,en

# Fact research web search (parallel; separate from LLM vendors above)
TAVILY_API_KEY=
BRAVE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEARCH_RESULTS_PER_QUERY=5
SEARCH_MAX_PAGES_PER_CHAPTER=6
SEARCH_FETCH_TIMEOUT_MS=10000
